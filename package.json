{
  "name": "@bchyper/connect-sdk",
  "version": "1.2.1",
  "description": "SDK for connecting BC Hyper mobile wallet to web dApps",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "wallet",
    "web3",
    "mobile",
    "dex",
    "bcswap",
    "bchyper",
    "connect",
    "sdk"
  ],
  "author": "PN Software PVT. LTD",
  "license": "ISC",
  "homepage": "https://github.com/ElectronicAPU/bchyper_connect#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ElectronicAPU/bchyper_connect.git"
  },
  "dependencies": {
    "eventemitter3": "^5.0.4",
    "socket.io-client": "^4.8.3"
  },
  "peerDependencies": {
    "react": ">=17.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
